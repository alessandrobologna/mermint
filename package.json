{
  "name": "mermint",
  "license": "MIT",
  "type": "module",
  "version": "0.2.1",
  "description": "Mint GitHub-ready Mermaid diagrams.",
  "bin": {
    "mermint": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "assets/**",
    "README.md",
    "LICENSE",
    "LICENSES/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "render": "node dist/cli.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "mermaid": "^11.14.0",
    "ora": "^9.3.0",
    "playwright": "^1.59.1",
    "svg2roughjs": "^3.2.3",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.2",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
